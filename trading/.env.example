# Trading Bot Environment Variables
# Copy this to .env and fill in your actual values

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# TwelveData API (Optional, for advanced data fetching)
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# Trading Configuration
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

BB_PERIOD=20
BB_STD_DEV=2

# Binary Options Configuration
EXPIRATION_TIME_MINUTES=5
BUFFER_SECONDS=10

# Symbols to monitor (comma-separated)
SYMBOLS=EURUSD=X,GBPUSD=X,USDJPY=X,BTC-USD,ETH-USD

# Signal Confidence Threshold (0-100)
CONFIDENCE_THRESHOLD=50

# Logging
LOG_LEVEL=INFO
